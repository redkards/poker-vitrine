# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# MariaDB 10.6 (Docker en local, o2switch en production) - identifiants alignes sur ../docker-compose.yml
DATABASE_URL="mysql://poker:poker@127.0.0.1:3307/pokervitrine?serverVersion=10.6.0-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# La vraie passphrase est definie dans .env.local (non versionne)
JWT_PASSPHRASE=ChangeMeInEnvLocal
JWT_TOKEN_TTL=3600
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/mailer ###
# Mailhog (docker-compose) : interface sur http://localhost:8025
MAILER_DSN=smtp://127.0.0.1:1025
MAILER_FROM=no-reply@pokervitrine.local
###< symfony/mailer ###

###> stripe ###
# Cles de TEST uniquement (pk_test_... / sk_test_...). Les vraies valeurs vont dans .env.local
STRIPE_PUBLIC_KEY=pk_test_changeme
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
###< stripe ###

###> mercure ###
MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< mercure ###

###> app ###
FRONTEND_URL=http://localhost:4200
# Version courante des CGU : a incrementer a chaque modification (consentement RGPD)
CGU_VERSION=1.0
# Production uniquement : noms d'hote acceptes (regex), ex. '^api\.redkards-dev\.fr$'
TRUSTED_HOSTS='^(localhost|127\.0\.0\.1)$'
# Abonnement Premium : prix TTC en centimes (a valider par le proprietaire)
PREMIUM_PRICE_MONTHLY_CENTS=499
PREMIUM_PRICE_YEARLY_CENTS=4900
# 0 = paiement en ligne ferme (POST /api/premium/subscribe repond 503)
PREMIUM_PAYMENT_ENABLED=0
###< app ###
